.trade-window {
    width: 360px;
    height: 540px;
    position: absolute;
    left: 280px;
    top: 100px;
}

.trade-window-content {
    flex-grow: 1;
    padding: 6px;
    display: flex;
    flex-direction: column;
}

.trade-section-header-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
}

.trade-section-label {
    font-size: 11px;
    color: #cca450;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.trade-status-label {
    font-size: 10px;
    color: #aaaaaa;
    padding: 1px 4px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 2px;
}

.trade-status-ok {
    color: #55ff55;
    background-color: rgba(0, 100, 0, 0.4);
    -unity-font-style: bold;
}

.trade-inventory-scroll {
    height: 140px;
    max-height: 140px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(80, 70, 50, 0.4);
    margin-bottom: 4px;
}

.trade-offer-scroll {
    height: 100px;
    max-height: 100px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(80, 70, 50, 0.4);
    margin-bottom: 4px;
}

.trade-slots-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px;
}

.trade-slot-elem {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    margin: 2px;
    background-color: #121318;
    border-width: 1px;
    border-color: #3f392e;
    position: relative;
}

.trade-slot-elem:hover {
    border-color: #d4af37;
}

.trade-slot-icon {
    width: 100%;
    height: 100%;
}

.trade-slot-count {
    position: absolute;
    bottom: 0px;
    right: 1px;
    font-size: 9px;
    color: #e0e0e0;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0px #000;
}

.trade-button-bar {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.trade-action-btn {
    width: 75px;
    height: 24px;
    margin-left: 6px;
    background-color: #2b271d;
    border-width: 1px;
    border-color: #5c523e;
    color: #e5d5be;
    font-size: 11px;
    -unity-font-style: bold;
}

.trade-action-btn:hover {
    background-color: #3d3729;
    border-color: #8c7d5e;
}

.trade-action-btn:active {
    background-color: #1f1c15;
}
