.ps-window {
    width: 460px;
    height: 480px;
    position: absolute;
    left: 280px;
    top: 130px;
}

.ps-window-content {
    flex-grow: 1;
    padding: 6px;
    display: flex;
    flex-direction: column;
}

.ps-title-label {
    font-size: 12px;
    color: #e5b350;
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(229, 179, 80, 0.3);
}

.ps-two-panels-container {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.ps-panel {
    width: 48.5%;
    display: flex;
    flex-direction: column;
}

.ps-panel-header {
    font-size: 11px;
    color: #c4b090;
    margin-bottom: 3px;
}

.ps-scroll-panel {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(80, 70, 50, 0.5);
}

.ps-slots-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px;
}

.ps-slot-elem {
    width: 32px;
    height: 32px;
    margin: 2px;
    background-color: rgba(20, 20, 20, 0.7);
    border-width: 1px;
    border-color: rgba(100, 90, 70, 0.6);
    position: relative;
}

.ps-slot-elem:hover {
    border-color: #e5b350;
}

.ps-slot-icon {
    width: 100%;
    height: 100%;
}

.ps-slot-count {
    position: absolute;
    bottom: 1px;
    right: 2px;
    font-size: 9px;
    color: #ffffff;
    -unity-font-style: bold;
}

.ps-info-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(100, 90, 70, 0.4);
}

.ps-info-text {
    font-size: 11px;
    color: #e5b350;
}

.ps-info-total {
    font-size: 11px;
    color: #55ff55;
    -unity-font-style: bold;
}

.ps-btn-bar {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.ps-action-btn {
    width: 72px;
    height: 22px;
    margin-left: 6px;
    font-size: 11px;
    color: #e0d0b0;
    background-color: rgba(40, 35, 25, 0.85);
    border-width: 1px;
    border-color: rgba(140, 120, 90, 0.8);
}

.ps-action-btn:hover {
    background-color: rgba(70, 60, 45, 0.9);
    border-color: #e5b350;
}
