.wh-window {
    width: 440px;
    height: 460px;
    position: absolute;
    left: 260px;
    top: 120px;
}

.wh-window-content {
    flex-grow: 1;
    padding: 6px;
    display: flex;
    flex-direction: column;
}

.wh-title-label {
    font-size: 12px;
    color: #e5b350;
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(229, 179, 80, 0.3);
}

.wh-two-panels-container {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.wh-panel {
    width: 48.5%;
    display: flex;
    flex-direction: column;
}

.wh-panel-header {
    font-size: 11px;
    color: #c4b090;
    margin-bottom: 3px;
}

.wh-scroll-panel {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(80, 70, 50, 0.5);
}

.wh-slots-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px;
}

.wh-slot-elem {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    margin: 2px;
    background-color: #121318;
    border-width: 1px;
    border-color: #3f392e;
    position: relative;
}

.wh-slot-elem:hover {
    border-color: #d4af37;
}

.wh-slot-icon {
    width: 100%;
    height: 100%;
}

.wh-slot-count {
    position: absolute;
    bottom: 0px;
    right: 1px;
    font-size: 9px;
    color: #e0e0e0;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0px #000;
}

.wh-info-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    margin-top: 4px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.wh-info-text {
    font-size: 11px;
    color: #ffd700;
}

.wh-info-fee {
    font-size: 11px;
    color: #ff9955;
}

.wh-btn-bar {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

.wh-action-btn {
    width: 75px;
    height: 24px;
    margin-left: 6px;
    background-color: #2b271d;
    border-width: 1px;
    border-color: #5c523e;
    color: #e5d5be;
    font-size: 11px;
    -unity-font-style: bold;
}

.wh-action-btn:hover {
    background-color: #3d3729;
    border-color: #8c7d5e;
}
