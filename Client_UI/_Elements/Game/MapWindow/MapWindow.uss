.map-window {
    width: 700px;
    height: 740px;
    position: absolute;
}

.map-window-content {
    flex-grow: 1;
    padding: 6px;
    background-color: rgba(15, 15, 18, 0.95);
}

.map-frame {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(90, 80, 60);
    background-color: rgb(5, 5, 5);
    justify-content: center;
    align-items: center;
}

.world-map-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}
