.macro-window {
    background-color: rgba(10, 10, 15, 0.92);
}

.macro-window-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 6px;
}

.macro-view-container {
    flex-grow: 1;
    flex-direction: column;
}

.macro-section-header {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 100, 60, 0.4);
}

.macro-list-scroll {
    flex-grow: 1;
    min-height: 250px;
    max-height: 390px;
}

.macro-items-container {
    flex-direction: column;
}

.macro-item-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    margin-bottom: 2px;
    padding: 2px 4px;
    background-color: rgba(20, 20, 25, 0.6);
    border-width: 1px;
    border-color: rgba(60, 60, 70, 0.5);
    border-radius: 2px;
}

.macro-item-row:hover {
    background-color: rgba(40, 40, 50, 0.7);
    border-color: rgba(150, 130, 80, 0.6);
}

.macro-item-row.selected {
    background-color: rgba(60, 50, 25, 0.85);
    border-color: rgb(210, 170, 60);
}

.macro-item-slot-wrapper {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

.macro-item-info {
    flex-direction: column;
    margin-left: 8px;
    flex-grow: 1;
    justify-content: center;
}

.macro-item-name {
    font-size: 11px;
    color: rgb(230, 210, 150);
    -unity-font-style: bold;
}

.macro-item-desc {
    font-size: 9px;
    color: rgb(150, 150, 150);
}

.macro-empty-label {
    font-size: 10px;
    color: rgb(160, 160, 160);
    -unity-text-align: middle-center;
    margin-top: 40px;
}

.macro-button-bar {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(100, 100, 100, 0.3);
}

.macro-action-btn {
    width: 80px;
    height: 22px;
    font-size: 10px;
}

.macro-edit-scroll {
    flex-grow: 1;
    max-height: 390px;
}

.macro-input-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.macro-input-label {
    font-size: 10px;
    color: rgb(180, 180, 180);
    width: 110px;
}

.macro-text-input {
    flex-grow: 1;
    height: 20px;
    font-size: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgba(80, 80, 80, 0.6);
    color: rgb(220, 220, 220);
}

.macro-icon-section {
    flex-direction: column;
    margin-top: 4px;
    margin-bottom: 4px;
}

.macro-icon-picker-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
    padding: 3px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(60, 60, 60, 0.5);
}

.macro-picker-icon-btn {
    width: 28px;
    height: 28px;
    margin: 2px;
    border-width: 1px;
    border-color: rgba(90, 90, 90, 0.5);
    background-color: rgba(15, 15, 20, 0.8);
}

.macro-picker-icon-btn.selected {
    border-width: 2px;
    border-color: rgb(230, 190, 50);
}

.macro-commands-container {
    flex-direction: column;
    margin-top: 3px;
}

.macro-cmd-line-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.macro-cmd-num {
    width: 20px;
    font-size: 9px;
    color: rgb(150, 150, 150);
    -unity-text-align: middle-right;
    margin-right: 4px;
}

.macro-cmd-input {
    flex-grow: 1;
    height: 19px;
    font-size: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgba(70, 70, 70, 0.6);
    color: rgb(220, 220, 220);
}
