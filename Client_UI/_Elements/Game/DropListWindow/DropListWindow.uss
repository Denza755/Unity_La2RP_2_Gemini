.droplist-window {
    width: 290px;
    height: 380px;
    position: absolute;
    left: 200px;
    top: 150px;
}

.droplist-window-content {
    flex-grow: 1;
    padding: 6px;
    display: flex;
    flex-direction: column;
}

.droplist-mob-header {
    font-size: 12px;
    color: #e0b060;
    -unity-font-style: bold;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(224, 176, 96, 0.3);
    white-space: normal;
}

.droplist-scroll-view {
    flex-grow: 1;
}

.droplist-items-container {
    display: flex;
    flex-direction: column;
}

.droplist-item-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(100, 90, 70, 0.3);
}

.droplist-item-row:hover {
    background-color: rgba(180, 150, 80, 0.2);
    border-color: rgba(220, 180, 100, 0.6);
}

.droplist-item-icon {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border-width: 1px;
    border-color: #3f392e;
    margin-right: 6px;
    background-color: #0b0c10;
}

.droplist-item-name {
    flex-grow: 1;
    font-size: 11px;
    color: #dedede;
    white-space: normal;
}

.droplist-empty-label {
    margin-top: 20px;
    font-size: 11px;
    color: #888888;
    -unity-text-align: middle-center;
}
