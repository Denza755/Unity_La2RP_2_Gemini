.ruler-top-panel {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 250px;
    background-color: rgba(14, 18, 25, 0.92);
    border-width: 2px;
    border-color: rgb(165, 138, 92);
    border-radius: 4px;
    padding: 6px;
    display: flex;
    flex-direction: column;
}

.ruler-header {
    background-color: rgba(35, 45, 60, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgb(165, 138, 92);
    padding: 4px;
    margin-bottom: 6px;
    align-items: center;
}

.ruler-title-label {
    color: rgb(240, 210, 140);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.ruler-body {
    flex-direction: column;
}

.ruler-main-btn {
    background-color: rgba(45, 30, 20, 0.9);
    border-color: rgb(180, 140, 80);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(255, 230, 180);
    padding: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ruler-main-btn:hover {
    background-color: rgba(75, 55, 30, 0.95);
    border-color: rgb(230, 190, 110);
}

.ruler-main-btn.active {
    background-color: rgba(20, 70, 40, 0.95);
    border-color: rgb(100, 220, 120);
    color: rgb(220, 255, 220);
}

.ruler-submodes-container {
    flex-direction: row;
    justify-content: space-between;
}

.ruler-mode-btn {
    flex-grow: 1;
    margin: 2px;
    background-color: rgba(30, 35, 45, 0.85);
    border-color: rgb(130, 110, 80);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(210, 210, 210);
    font-size: 11px;
    padding: 5px;
}

.ruler-mode-btn:hover {
    background-color: rgba(50, 60, 80, 0.95);
    border-color: rgb(180, 150, 100);
}

.ruler-mode-btn.selected {
    background-color: rgba(18, 60, 100, 0.95);
    border-color: rgb(110, 180, 255);
    color: rgb(240, 250, 255);
    -unity-font-style: bold;
}

/* Bottom Ruler Build Bar */
.ruler-build-bar {
    position: absolute;
    bottom: 40px;
    left: 15%;
    right: 15%;
    height: 185px;
    min-height: 185px;
    background-color: rgba(12, 16, 22, 0.96);
    border-width: 2px;
    border-color: rgb(165, 138, 92);
    border-radius: 6px;
    padding: 6px 10px;
    display: none;
    flex-direction: column;
}

.build-bar-header {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 138, 92, 0.6);
    padding-bottom: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
    height: 26px;
}

.build-bar-title {
    color: rgb(235, 205, 135);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.pagination-container {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.pagination-btn {
    background-color: rgba(35, 45, 60, 0.9);
    border-width: 1px;
    border-color: rgb(165, 138, 92);
    border-radius: 3px;
    color: rgb(240, 215, 160);
    font-size: 11px;
    padding: 2px 8px;
    margin-left: 2px;
    margin-right: 2px;
    height: 22px;
}

.pagination-btn:hover {
    background-color: rgba(55, 75, 105, 0.95);
    border-color: rgb(220, 190, 120);
}

.pagination-label {
    color: rgb(235, 220, 180);
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 6px;
    margin-right: 6px;
}

.build-bar-action-btn {
    font-size: 11px;
    padding: 2px 8px;
    margin-left: 6px;
    border-radius: 3px;
    border-width: 1px;
    height: 22px;
}

.demolish-btn {
    background-color: rgba(80, 25, 25, 0.85);
    border-color: rgb(220, 80, 80);
    color: rgb(255, 210, 210);
}

.demolish-btn:hover {
    background-color: rgba(120, 35, 35, 0.95);
    border-color: rgb(255, 110, 110);
}

.cancel-btn {
    background-color: rgba(45, 50, 60, 0.85);
    border-color: rgb(140, 140, 160);
    color: rgb(230, 230, 240);
}

.cancel-btn:hover {
    background-color: rgba(65, 75, 90, 0.95);
    border-color: rgb(180, 180, 210);
}

.buildings-grid-container {
    min-height: 86px;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    align-items: center;
    width: 100%;
}

.building-card-btn {
    width: 125px;
    height: 36px;
    margin-right: 6px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.build-bar-footer {
    border-top-width: 1px;
    border-top-color: rgba(165, 138, 92, 0.4);
    padding-top: 4px;
    margin-top: 4px;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
}

.ruler-help-text {
    color: rgb(175, 165, 145);
    font-size: 10px;
}
