<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="WindowTemplate" src="project://database/Assets/Resources/Data/UI/_Elements/Components/WindowTemplate.uxml?fileID=9197481963319205126&amp;guid=5ca840f56ef6f1044b4dc077c7d3e6e6&amp;type=3#WindowTemplate" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <ui:Instance template="WindowTemplate" name="WindowTemplate" class="clan-window">
        <ui:VisualElement name="Content" class="clan-window-content">
            <!-- Clan Info Header Box -->
            <ui:VisualElement class="clan-info-box">
                <ui:VisualElement class="clan-info-row">
                    <ui:Label name="ClanNameLabel" text="Clan: -" class="clan-name-text" />
                    <ui:Label name="ClanLevelLabel" text="Level: -" class="clan-lv-text" />
                </ui:VisualElement>
                <ui:VisualElement class="clan-info-row">
                    <ui:Label name="ClanLeaderLabel" text="Leader: -" class="clan-leader-text" />
                    <ui:Label name="ClanMembersCountLabel" text="Members: 0" class="clan-count-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Table Header -->
            <ui:VisualElement class="clan-table-header">
                <ui:Label text="Name" class="clan-col-header clan-col-name" />
                <ui:Label text="Lv." class="clan-col-header clan-col-lv" />
                <ui:Label text="Class" class="clan-col-header clan-col-class" />
                <ui:Label text="Status" class="clan-col-header clan-col-status" />
            </ui:VisualElement>

            <!-- Members List ScrollView -->
            <ui:ScrollView name="ClanMembersScroll" class="clan-members-scroll">
                <ui:VisualElement name="ClanMembersContainer" class="clan-members-container" />
            </ui:ScrollView>

            <!-- Bottom Button Bar -->
            <ui:VisualElement class="clan-btn-bar">
                <ui:Button name="ClanRefreshBtn" text="Refresh" class="clan-action-btn" />
                <ui:Button name="ClanCloseBtn" text="Close" class="clan-action-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Instance>
</ui:UXML>
